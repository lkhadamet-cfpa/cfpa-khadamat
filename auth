<?php
declare(strict_types=1);

require_once __DIR__ . '/../config.php';

/*
|--------------------------------------------------------------------------
| منع الوصول إذا كان المستخدم مسجلاً بالفعل
|--------------------------------------------------------------------------
*/

if (isLoggedIn()) {
    header('Location: /dashboard.php');
    exit;
}

$error = '';
$success = '';

/*
|--------------------------------------------------------------------------
| معالجة تسجيل الدخول
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $username = trim($_POST['username'] ?? '');
    $password = $_POST['password'] ?? '';

    if ($username === '' || $password === '') {

        $error = 'يرجى إدخال اسم المستخدم وكلمة المرور.';

    } elseif ($pdo === null) {

        $error = 'الخادم غير متصل بقاعدة البيانات حاليًا.';

    } else {

        try {

            $stmt = $pdo->prepare(
                "SELECT id, username, password_hash, full_name, role, status
                 FROM users
                 WHERE username = :username
                 LIMIT 1"
            );

            $stmt->execute([
                ':username' => $username
            ]);

            $user = $stmt->fetch();

            /*
            |--------------------------------------------------------------------------
            | التحقق من الحساب وكلمة المرور
            |--------------------------------------------------------------------------
            */

            if (
                !$user ||
                !password_verify($password, $user['password_hash'])
            ) {

                $error = 'اسم المستخدم أو كلمة المرور غير صحيحة.';

            } elseif (($user['status'] ?? '') !== 'active') {

                $error = 'هذا الحساب غير مفعل. يرجى التواصل مع الإدارة.';

            } else {

                /*
                |--------------------------------------------------------------------------
                | تجديد الجلسة لمنع Session Fixation
                |--------------------------------------------------------------------------
                */

                session_regenerate_id(true);

                $_SESSION['user_id'] = (int) $user['id'];
                $_SESSION['username'] = $user['username'];
                $_SESSION['full_name'] = $user['full_name'] ?? '';
                $_SESSION['role'] = $user['role'] ?? 'worker';
                $_SESSION['login_time'] = time();

                /*
                |--------------------------------------------------------------------------
                | تسجيل وقت آخر دخول
                |--------------------------------------------------------------------------
                */

                try {

                    $update = $pdo->prepare(
                        "UPDATE users
                         SET last_login = NOW()
                         WHERE id = :id"
                    );

                    $update->execute([
                        ':id' => (int) $user['id']
                    ]);

                } catch (Throwable $e) {

                    error_log(
                        'Last login update error: ' .
                        $e->getMessage()
                    );
                }

                /*
                |--------------------------------------------------------------------------
                | توجيه المستخدم بعد تسجيل الدخول
                |--------------------------------------------------------------------------
                */

                if (($user['role'] ?? '') === 'admin') {

                    header('Location: /admin/dashboard.php');

                } else {

                    header('Location: /dashboard.php');
                }

                exit;
            }

        } catch (Throwable $e) {

            error_log(
                'Login error: ' .
                $e->getMessage()
            );

            $error = 'حدث خطأ أثناء تسجيل الدخول. حاول مرة أخرى.';
        }
    }
}

